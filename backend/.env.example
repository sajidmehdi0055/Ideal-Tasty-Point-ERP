# Local-only placeholders. Never use the migration owner for the API connection.
DATABASE_URL=postgres://inv_s01_runtime:replace-with-local-password@127.0.0.1:5432/erp_local
PORT=3000
# Administrator of an EMPTY, disposable test database; tests create unique schemas.
TEST_DATABASE_URL=postgres://postgres:replace-with-local-password@127.0.0.1:5432/erp_test

# --- AI layer (ADR-0012). OFF by default; the ERP runs normally without it. ---
# Never put real keys in this file or in Git. Set them only in your local .env.
AI_ENABLED=false
# local | openai | anthropic   (openai/anthropic are cloud: need AI_CLOUD_ENABLED=true)
AI_PRIMARY_PROVIDER=local
AI_FALLBACK_PROVIDER=
# Owner decision AI-O-02: no ERP data goes to any cloud provider unless this is true.
AI_CLOUD_ENABLED=false
AI_TOOL_CALLING_ENABLED=true
# Phase 1 has no write tools; keep false.
AI_WRITE_ACTIONS_ENABLED=false
# Any OpenAI-compatible local server, e.g. Ollama (http://127.0.0.1:11434/v1) or LM Studio (http://127.0.0.1:1234/v1)
AI_LOCAL_BASE_URL=http://127.0.0.1:11434/v1
AI_LOCAL_MODEL=
AI_LOCAL_API_KEY=
AI_OPENAI_BASE_URL=https://api.openai.com/v1
AI_OPENAI_API_KEY=
AI_OPENAI_MODEL=
AI_ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
AI_ANTHROPIC_API_KEY=
AI_ANTHROPIC_MODEL=
AI_REQUEST_TIMEOUT_MS=60000
AI_MAX_TOOL_ROUNDS=4
AI_RATE_LIMIT_PER_MINUTE=20
